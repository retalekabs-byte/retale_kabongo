# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Brevo (SMTP & API → clés API, la clé commence par xkeysib-)
MAIL_MAILER=brevo
BREVO_API_KEY=colle-ici-la-cle-api-brevo
# Nom affiché et adresse validée dans Brevo → Expéditeurs
MAIL_FROM_NAME=Kadea Chat
MAIL_FROM_ADDRESS=colle-ici-ton-email-valide-chez-brevo

# Database (PostgreSQL)
DB_CONNECTION=pg
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_DATABASE=projet-kadea