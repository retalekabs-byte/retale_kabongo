<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content"
    />
    <title>{{ $props.get('title') || 'Kadea Chat' }}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              dark: '#161616',
              features: '#f7f8ff',
              brand: '#3147ff',
            },
            fontFamily: {
              sans: ['"Plus Jakarta Sans"', 'system-ui', 'sans-serif'],
            },
          },
        },
      }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/kadea.css" />
    <script>
      try {
        if (localStorage.getItem('kadea-theme') === 'dark') {
          document.documentElement.classList.add('theme-dark')
        }
      } catch (e) {}
    </script>
  </head>
  <body class="font-sans antialiased {{ $props.get('bodyClass') }}">
    <script>
      try {
        if (document.documentElement.classList.contains('theme-dark')) {
          document.body.classList.add('theme-dark')
        }
      } catch (e) {}
    </script>
    {{{ await $slots.main() }}}
    <script src="/js/kadea-ui.js"></script>
  </body>
</html>
