<article class="feature-card {{ $props.get('class') }}">
  <div class="feature-icon" tabindex="0" aria-label="{{ $props.get('label') }}">
    {{{ await $slots.icon() }}}
  </div>
  <h3 class="text-xl font-bold text-dark sm:text-2xl">{{ $props.get('title') }}</h3>
  <ul class="feature-list">
    {{{ await $slots.main() }}}
  </ul>
</article>
