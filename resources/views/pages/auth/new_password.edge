@kadea.auth({
  title: 'Nouveau mot de passe — Kadea Chat',
  headerCtaHref: route('session.create'),
  headerCtaLabel: 'Se connecter',
})
  <h1 class="auth-title">Nouveau mot de passe</h1>
  <p class="auth-subtitle">Choisis un mot de passe d’au moins 8 caractères. Ce lien ne pourra plus servir.</p>

  <form class="auth-form" action="{{ route('password.reset.update', { token }) }}" method="post">
    {{ csrfField() }}
    <div class="auth-field">
      <label for="password">Mot de passe</label>
      <input id="password" name="password" type="password" placeholder="••••••••" required autocomplete="new-password" />
      @kadea.field_error({ name: 'password' })
    </div>
    <div class="auth-field">
      <label for="passwordConfirmation">Confirmer le mot de passe</label>
      <input id="passwordConfirmation" name="passwordConfirmation" type="password" placeholder="••••••••" required autocomplete="new-password" />
      @kadea.field_error({ name: 'passwordConfirmation' })
    </div>
    <button type="submit" class="btn-primary auth-submit">Enregistrer</button>
  </form>
@end
