@kadea.auth({
  title: 'Vérification e-mail — Kadea Chat',
  headerCtaHref: route('session.create'),
  headerCtaLabel: 'Se connecter',
})
  <h1 class="auth-title">Vérifie ton e-mail</h1>
  <p class="auth-subtitle">
    @if(session.get('pendingVerificationEmail'))
      Un lien de confirmation a été envoyé à {{ session.get('pendingVerificationEmail') }}.
      Ouvre-le pour activer ton compte avant de te connecter.
    @else
      Ouvre le lien reçu par e-mail pour activer ton compte avant de te connecter.
    @end
  </p>

  <div class="auth-message">
    Sans confirmation, la connexion est refusée. Pense à regarder aussi dans les spams.
  </div>

  <div class="auth-actions">
    @if(session.get('pendingVerificationEmail'))
      <form action="{{ route('email_verification.resend') }}" method="post">
        {{ csrfField() }}
        <button type="submit" class="btn-primary auth-submit">Renvoyer l’e-mail</button>
      </form>
    @end
    <a href="{{ route('session.create') }}" class="btn-ghost">Retour à la connexion</a>
  </div>
@end
