@kadea.chat({
  title: 'Nouveau groupe — Kadea Chat',
  bodyClass: 'chat-body',
  chatMode: 'chat',
  conversations: conversations,
  query: query,
  showList: false,
})
  <section class="chat-main" aria-label="Nouveau groupe">
    <header class="chat-main-head">
      <a href="{{ route('chat') }}" class="chat-icon-btn md:hidden" id="btn-back-list" aria-label="Retour à la liste">
        <svg fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
      </a>
      <div class="min-w-0 flex-1">
        <h2>Nouveau groupe</h2>
      </div>
    </header>

    <form class="chat-group-form" action="{{ route('groups.store') }}" method="post" enctype="multipart/form-data">
      {{ csrfField() }}
      @each(member in selected)
        <input type="hidden" name="members" value="{{ member.id }}" />
      @end
      <div class="auth-field">
        <label for="name">Nom du groupe</label>
        <input id="name" name="name" type="text" value="{{ old('name') || name }}" required maxlength="255" />
        @!kadea.fieldError({ name: 'name' })
        @!kadea.fieldError({ name: 'members' })
      </div>
      <div class="auth-field">
        <label for="avatar">Photo, optionnelle</label>
        <input id="avatar" name="avatar" type="file" accept="image/png,image/jpeg,image/webp,image/gif" />
      </div>
      <button type="submit" class="btn-primary auth-submit">Créer le groupe</button>
    </form>

    <div class="chat-messages">
      @if(flashMessages?.has('error'))
        <div class="auth-message auth-message--error chat-flash" role="alert">{{ flashMessages.get('error') }}</div>
      @end

      @each(member in selected)
        <form class="chat-person js-keep-name" action="{{ route('groups.create') }}" method="get">
          <input type="hidden" name="name" value="{{ name }}" class="js-name-copy" />
          <input type="hidden" name="q" value="{{ query }}" />
          @each(other in selected)
            @if(other.id !== member.id)
              <input type="hidden" name="members" value="{{ other.id }}" />
            @end
          @end
          <div class="chat-avatar" aria-hidden="true">{{ member.initials }}</div>
          <div class="chat-conv-meta">
            <span class="chat-conv-name">{{ member.fullName }}</span>
            <p class="chat-conv-preview">Dans le groupe</p>
          </div>
          <button type="submit" class="chat-person-btn chat-person-btn--quiet">Retirer</button>
        </form>
      @end

      <form class="chat-search chat-search--panel js-keep-name" action="{{ route('groups.create') }}" method="get">
        <input type="hidden" name="name" value="{{ name }}" class="js-name-copy" />
        @each(member in selected)
          <input type="hidden" name="members" value="{{ member.id }}" />
        @end
        <input type="search" name="q" value="{{ query }}" placeholder="Ajouter une personne…" aria-label="Ajouter une personne" />
      </form>

      @each(person in people)
        <form class="chat-person js-keep-name" action="{{ route('groups.create') }}" method="get">
          <input type="hidden" name="name" value="{{ name }}" class="js-name-copy" />
          <input type="hidden" name="q" value="{{ query }}" />
          @each(member in selected)
            <input type="hidden" name="members" value="{{ member.id }}" />
          @end
          <input type="hidden" name="members" value="{{ person.id }}" />
          <div class="chat-avatar" aria-hidden="true">{{ person.initials }}</div>
          <div class="chat-conv-meta">
            <span class="chat-conv-name">{{ person.fullName }}</span>
            <p class="chat-conv-preview">{{ person.email }}</p>
          </div>
          <button type="submit" class="btn-primary chat-person-btn">Ajouter</button>
        </form>
      @else
        @if(query)
          <p class="chat-empty">Aucune personne trouvée.</p>
        @else
          <p class="chat-empty">Choisis au moins une autre personne. Le créateur devient admin.</p>
        @end
      @end
    </div>
  </section>
  <script>
    document.querySelectorAll('.js-keep-name').forEach(function (form) {
      form.addEventListener('submit', function () {
        var source = document.getElementById('name')
        var target = form.querySelector('.js-name-copy')
        if (source && target) target.value = source.value
      })
    })
  </script>
@end
