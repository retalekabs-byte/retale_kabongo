@kadea.chat({
  title: title,
  bodyClass: 'chat-body',
  chatMode: 'chat',
  conversations: conversations,
  activeId: conversation ? conversation.id : null,
  showList: !conversation,
})
  <section class="chat-main" aria-label="Conversation active">
    @if(flashMessages?.has('error'))
      <div class="auth-message auth-message--error chat-flash" role="alert">{{ flashMessages.get('error') }}</div>
    @end
    @if(flashMessages?.has('success'))
      <div class="auth-message auth-message--success chat-flash" role="status">{{ flashMessages.get('success') }}</div>
    @end

    @if(conversation)
      <header class="chat-main-head">
        <a href="{{ route('chat') }}" class="chat-icon-btn md:hidden" id="btn-back-list" aria-label="Retour à la liste">
          <svg fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </a>
        <div class="min-w-0 flex-1">
          <h2>{{ heading }}</h2>
        </div>
        <div class="chat-main-actions">
          @include('partials/kadea/theme_toggle')
        </div>
        @if(conversation.type === 'private' && peer)
          <div class="chat-info">
            <button type="button" class="chat-icon-btn" id="btn-peer-info" aria-label="Informations" title="Informations">
              <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="9" />
                <path stroke-linecap="round" d="M12 11v6" />
                <circle cx="12" cy="7.5" r="0.8" fill="currentColor" stroke="none" />
              </svg>
            </button>
            <div id="peer-info-pop" class="chat-info-pop" hidden>
              <div class="chat-info-card">
                @if(peer.avatar)
                  <img src="{{ peer.avatar }}" alt="" class="chat-avatar chat-info-avatar" />
                @else
                  <div class="chat-avatar chat-info-avatar" aria-hidden="true">{{ peer.initials }}</div>
                @end
                <p class="chat-info-name">{{ peer.fullName }}</p>
                <p class="chat-info-email">{{ peer.email }}</p>
                @if(blocked)
                  <p class="chat-pop-hint">Les messages privés sont coupés.</p>
                @end
                @if(blockedByMe)
                  <form action="{{ route('blocks.destroy', { userId: peer.id }) }}" method="post">
                    {{ csrfField() }}
                    <button type="submit" class="chat-text-btn">Débloquer</button>
                  </form>
                @else
                  <form action="{{ route('blocks.store') }}" method="post">
                    {{ csrfField() }}
                    <input type="hidden" name="userId" value="{{ peer.id }}" />
                    <button type="submit" class="chat-text-btn">Bloquer</button>
                  </form>
                @end
              </div>
            </div>
          </div>
        @end
        @if(conversation.type === 'group')
          <div class="chat-info">
            <button type="button" class="chat-icon-btn" id="btn-group-info" aria-label="Informations du groupe" title="Informations">
              <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="9" />
                <path stroke-linecap="round" d="M12 11v6" />
                <circle cx="12" cy="7.5" r="0.8" fill="currentColor" stroke="none" />
              </svg>
            </button>
            <div
              id="group-info-pop"
              class="chat-info-pop chat-info-pop--group"
              hidden
              data-people="{{ route('conversations.people') }}"
              data-members="{{ groupMemberIds }}"
            >
              <div class="chat-info-card chat-info-card--group">
                <p class="chat-info-label">Nom du groupe</p>
                <p class="chat-info-name">{{ heading }}</p>

                <p class="chat-info-label">Personnes</p>
                <div class="chat-info-people">
                  @each(member in groupMembers)
                    <div class="chat-person">
                      <div class="chat-avatar" aria-hidden="true">{{ member.initials }}</div>
                      <div class="chat-conv-meta">
                        <span class="chat-conv-name">{{ member.fullName }}</span>
                        <p class="chat-conv-preview">{{ member.role }}</p>
                      </div>
                      @if(isGroupAdmin && !member.mine)
                        <form action="{{ route('groups.remove', { id: conversation.id, userId: member.id }) }}" method="post">
                          {{ csrfField() }}
                          <button type="submit" class="chat-person-btn chat-person-btn--quiet">Retirer</button>
                        </form>
                      @end
                    </div>
                  @end
                </div>

                @if(isGroupAdmin)
                  <form id="group-add-form" class="chat-info-add" action="{{ route('groups.add', { id: conversation.id }) }}" method="post">
                    {{ csrfField() }}
                    <p class="chat-info-label">Ajouter</p>
                    <input id="group-add-search" type="search" placeholder="Rechercher une personne…" aria-label="Rechercher une personne" />
                    <div id="group-add-list" class="chat-info-people"></div>
                    <p id="group-add-hint" class="chat-pop-hint">Coche au moins une personne.</p>
                    <button type="submit" class="btn-primary auth-submit">Ajouter</button>
                  </form>
                @end
              </div>
            </div>
          </div>
        @end
      </header>

      <div class="chat-messages">
        @each(message in messages)
          <div class="chat-row {{ message.mine ? 'chat-row--out' : '' }}" data-message-id="{{ message.id }}">
            @if(message.mine)
              <div class="chat-bubble-menu">
                <div class="chat-bubble-menu-panel">
                  <form action="{{ route('messages.destroy', { id: conversation.id, messageId: message.id }) }}" method="post">
                    {{ csrfField() }}
                    <button type="submit">Supprimer</button>
                  </form>
                </div>
              </div>
            @end
            <div class="chat-bubble {{ message.mine ? 'chat-bubble--out' : 'chat-bubble--in' }}">
              @if(message.mine)
                <button type="button" class="chat-bubble-more" aria-label="Actions du message" aria-expanded="false">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <circle cx="12" cy="5" r="1.7" />
                    <circle cx="12" cy="12" r="1.7" />
                    <circle cx="12" cy="19" r="1.7" />
                  </svg>
                </button>
              @end
              <span class="chat-bubble-author">{{ message.author }}</span>
              {{ message.body }}
              <time>{{ message.time }}</time>
            </div>
          </div>
        @else
          <p class="chat-empty">Aucun message pour le moment.</p>
        @end
      </div>

      @let(bodyErrors = flashMessages.get('inputErrorsBag', {}).body || [])
      @each(error in bodyErrors)
        <p class="chat-composer-error">{{ error }}</p>
      @end

      @if(blockedByMe)
        <p class="chat-composer-error chat-composer-error--blocked">Vous avez bloqué cette personne</p>
      @end

      @if(!blocked)
        <form class="chat-composer" action="{{ route('messages.store', { id: conversation.id }) }}" method="post">
          {{ csrfField() }}
          <input type="text" name="body" value="{{ old('body') || '' }}" placeholder="Écrire un message…" aria-label="Message" autocomplete="off" required maxlength="5000" />
          <button type="submit" class="chat-send" aria-label="Envoyer">
            <svg fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z" />
            </svg>
          </button>
        </form>
      @end
    @else
      <div class="chat-messages">
        <p class="chat-empty">Choisis une conversation, ou démarres-en une avec le bouton +.</p>
      </div>
    @end
  </section>
@end
