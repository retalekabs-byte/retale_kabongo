@kadea.chat({
  title: 'Chat — Kadea Chat',
  bodyClass: 'chat-body',
  chatMode: 'chat',
})
  <section class="chat-main" aria-label="Conversation active">
    <header class="chat-main-head">
      <button type="button" class="chat-icon-btn md:hidden" id="btn-back-list" aria-label="Retour à la liste">
        <svg fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
      </button>
      <div class="min-w-0 flex-1">
        <h2>Amina Mbuyi</h2>
      </div>
    </header>

    <div class="chat-messages">
      <div class="chat-day">Aujourd’hui</div>

      <div class="chat-bubble chat-bubble--in">
        Salut ! Tu as avancé sur la messagerie ?
        <time>13:48</time>
      </div>
      <div class="chat-bubble chat-bubble--out">
        Oui — auth, groupes et chat privé sont en place.
        <time>13:51</time>
      </div>
      <div class="chat-bubble chat-bubble--in">
        Super. On se voit demain pour le projet ?
        <time>14:22</time>
      </div>
      <div class="chat-bubble chat-bubble--out">
        Parfait, demain 10h.
        <time>14:24</time>
      </div>
    </div>

    <form class="chat-composer" action="#" method="get" onsubmit="return false;">
      <input type="text" name="body" placeholder="Écrire un message…" aria-label="Message" autocomplete="off" />
      <button type="submit" class="chat-send" aria-label="Envoyer">
        <svg fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z" />
        </svg>
      </button>
    </form>
  </section>
@end
